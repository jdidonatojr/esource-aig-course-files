<!-- ========== EXTERNAL LIBRARIES ========== -->
<script src="https://player.vimeo.com/api/player.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
<!-- ========== PLAYER LOGIC (module: imports the ElevenLabs SDK) ========== -->
<script type="module">
  import { Conversation } from 'https://cdn.jsdelivr.net/npm/@elevenlabs/client/+esm';

  const AGENT_ID = 'agent_4801m0pmrh7tebes3vc7zr90me4c';
  var COURSES_URL = 'https://raw.githubusercontent.com/jdidonatojr/esource-aig-course-files/main/presentations.json';

  fetch(COURSES_URL, { cache: 'no-store' })
    .then(function(r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
    .then(function(lib) { bootWithLibrary(lib); })
    .catch(function(err) {
      console.warn('presentations.json did not load.', err);
      document.body.innerHTML =
        '<div style="display:flex;align-items:center;justify-content:center;height:100vh;' +
        'font-family:system-ui,-apple-system,Arial,sans-serif;font-size:18px;color:#333;' +
        'text-align:center;padding:24px;box-sizing:border-box;">' +
        'Presentation list is temporarily unavailable. Please refresh.</div>';
    });

  function bootWithLibrary(COURSE_LIBRARY) {

  const urlParams = new URLSearchParams(window.location.search);
  const courseKey = urlParams.get('course');

  if (!courseKey || !COURSE_LIBRARY[courseKey]) {
    showErrorPage();
    return;
  }

  const COURSE = COURSE_LIBRARY[courseKey];

  function showErrorPage() {
    document.getElementById('ailaPlayer').style.display = 'none';
    const errorPage = document.getElementById('ailaErrorPage');
    errorPage.style.display = 'flex';
    const courseList = document.getElementById('ailaCourseList');
    Object.keys(COURSE_LIBRARY).forEach(function(key) {
      const course = COURSE_LIBRARY[key];
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = '?course=' + key;
      a.textContent = course.title;
      li.appendChild(a);
      courseList.appendChild(li);
    });
  }

  document.getElementById('ailaPlayer').style.display = 'flex';
  document.getElementById('ailaCourseLabel').textContent = COURSE.title;
  document.title = COURSE.title + ' \u2014 ESource AI Group';

  const sectionJump = document.getElementById('ailaSectionJump');
  COURSE.sections.forEach(function(section) {
    const option = document.createElement('option');
    option.value = section.startSlide;
    option.textContent = section.label;
    sectionJump.appendChild(option);
  });

  // STATE
  let currentSlide = 1;
  let pdfDoc = null;
  let highestSlideReached = 1;

  const stored = localStorage.getItem('esource_presenter_progress_' + COURSE.id);
  if (stored) {
    try {
      const data = JSON.parse(stored);
      highestSlideReached = data.highestSlideReached || 1;
      currentSlide = data.lastSlide || 1;
    } catch (e) {}
  }

  // ============================================================
  // THE CONVERSATION (ElevenLabs SDK) + FLOW ENGINE
  // v3.1: advance_slide QUEUES the turn; the page applies it the
  // moment Bill's audio actually ends. Screen can't outrun voice.
  // ============================================================
  var convo = null;             // the live conversation object
  var voiceActive = false;
  var agentSpeaking = false;
  var begun = false;            // has [BEGIN PRESENTATION] been sent
  var flowPauseUntil = 0;       // hand raise / user speech pauses flow
  var nudgeTimer = null;
  var QUIET_MS = 4500;          // gap after speech before flowing on
  var spokeSinceNudge = false;  // only nudge once per speaking cycle
  var lastNudgeAt = 0;          // when we last sent a flow signal
  var lastAdvanceAt = 0;        // when the slide last actually changed
  var MIN_SLIDE_MS = 2500;      // double-call guard: min time between turns
  var slidesShownAt = 0;        // when the deck appeared
  var agentTurns = 0;           // Bill's speaking turns (slide-1 guard)
  var userSpokeThisSlide = false; // listener spoke on this slide (Q&A)

  function setStatus(mode, text) {
    var orb = document.getElementById('ailaStatusOrb');
    orb.className = 'aila-status-orb' + (mode ? ' ' + mode : '');
    document.getElementById('ailaStatusText').textContent = text;
  }

  // LIVE TRANSCRIPT
  var lastBubbleKey = '';
  function addTranscript(who, text) {
    var key = who + '|' + text;
    if (key === lastBubbleKey) return;   // filter duplicate events
    lastBubbleKey = key;
    var empty = document.getElementById('ailaTranscriptEmpty');
    if (empty) empty.remove();
    var box = document.getElementById('ailaTranscript');
    var b = document.createElement('div');
    b.className = 'aila-bubble ' + (who === 'user' ? 'user' : 'agent');
    var label = document.createElement('span');
    label.className = 'who';
    label.textContent = (who === 'user') ? 'You' : 'Bill';
    b.appendChild(label);
    b.appendChild(document.createTextNode(text));
    box.appendChild(b);
    box.scrollTop = box.scrollHeight;
  }

  function scheduleNudge() {
    clearTimeout(nudgeTimer);
    if (!voiceActive) return;
    if (currentSlide >= COURSE.totalSlides) return;
    nudgeTimer = setTimeout(function() {
      if (!voiceActive) return;
      if (agentSpeaking) { scheduleNudge(); return; }
      if (Date.now() < flowPauseUntil) { scheduleNudge(); return; }
      if (!spokeSinceNudge && (Date.now() - lastNudgeAt) < 12000) {
        scheduleNudge(); return;
      }
      try {
        if (convo && !begun) {
          // v5.0: the only page signal left is the opening kick-off.
          // After that, the LISTENER'S confirmation drives the flow.
          convo.sendUserMessage('[BEGIN PRESENTATION]');
          begun = true;
          lastNudgeAt = Date.now();
          spokeSinceNudge = false;
        }
      } catch (e) { console.warn('nudge failed', e); }
    }, QUIET_MS);
  }

  function tellAgentSlide() {
    try {
      if (convo) {
        convo.sendContextualUpdate(
          'The viewer\'s screen now shows slide ' + currentSlide +
          ' of ' + COURSE.totalSlides + '.');
      }
    } catch (e) {}
  }

  // Bill's greeting in the viewer's language (same service as slides)
  async function translatedFirstMessage() {
    if (currentLang === 'en') return COURSE.firstMessage;
    try {
      var r = await fetch(TRANSLATE_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          target_lang: currentLang,
          lines: [COURSE.firstMessage]
        })
      });
      if (r.ok) {
        var d = await r.json();
        if (d.lines && d.lines[0]) return d.lines[0];
      }
    } catch (e) {}
    return COURSE.firstMessage;
  }

  async function startConversation() {
    if (convo) return;
    setStatus('', 'Connecting…');
    var greeting = await translatedFirstMessage();
    try {
      convo = await Conversation.startSession({
        agentId: AGENT_ID,
        overrides: {
          agent: { firstMessage: greeting, language: currentLang }
        },
        dynamicVariables: {
          course_id: COURSE.id,
          course_title: COURSE.title,
          total_slides: String(COURSE.totalSlides),
          course_number: String(courseKey)   // v5.5: picks this presentation's Workflow branch
        },
        clientTools: {
          display_document: async function(params) {
            var url = params && (params.url || params.link);
            if (url) {
              seenDocLinks[url] = true;
              latestDocLink = url;
              document.getElementById('ailaDocToast').classList.add('show');
              return 'Banner shown. Tell the learner to click Open on the green banner.';
            }
            return 'No url received.';
          },
          advance_slide: async function() {
            // v5.0: instant turn — same mechanism as the teacher pages.
            var now = Date.now();
            if (now - lastAdvanceAt < MIN_SLIDE_MS) {
              return 'IGNORED: too soon. Stay on slide ' + currentSlide +
                ' and keep presenting it fully. Do not call advance_slide again yet.';
            }
            if (currentSlide === 1 && agentTurns < 2) {
              // v5.3: turn 1 is the greeting. Until Bill has ALSO delivered
              // slide 1 (turn 2), the first "yes" means "present slide 1",
              // never "advance".
              return 'IGNORED: slide 1 is ALREADY on the screen and has not ' +
                'been presented yet. The listener\'s yes meant "begin". ' +
                'Present slide 1 fully now; call advance_slide only after ' +
                'slide 1 is finished and the listener confirms again.';
            }
            if (currentSlide >= COURSE.totalSlides) {
              return 'IGNORED: already on the last slide (' + currentSlide +
                ' of ' + COURSE.totalSlides + '). Do not call advance_slide again.';
            }
            currentSlide++;
            lastAdvanceAt = now;
            userSpokeThisSlide = false;
            renderSlide(currentSlide);
            updateSlideIndicator();
            return 'DONE: the screen now shows slide ' + currentSlide + ' of ' +
              COURSE.totalSlides + '. Present this slide now.';
          }
        },
        onModeChange: function(m) {
          var mode = (m && m.mode) ? m.mode : m;
          if (mode === 'speaking') {
            agentSpeaking = true;
            spokeSinceNudge = true;
            clearTimeout(nudgeTimer);
            setStatus('speaking', 'Presenting…');
          } else {
            agentSpeaking = false;
            setStatus('listening', 'Listening');
            scheduleNudge();   // opening kick-off only (no-op once begun)
          }
        },
        onMessage: function(m) {
          var src = (m && (m.source || m.role)) || '';
          var text = (m && (m.message || m.text)) || '';
          if (!text) return;
          if (src === 'user') {
            if (text.indexOf('[') !== 0) {
              // Real learner speech — show it and give Q&A room to breathe.
              addTranscript('user', text);
              userSpokeThisSlide = true;
              flowPauseUntil = Date.now() + 45000;
            }
          } else {
            agentTurns++;         // v5.3: greeting = 1, slide 1 = 2, ...
            addTranscript('agent', text);
            watchForDocLinks(text);
          }
        },
        onStatusChange: function(s) {
          var st = (s && s.status) ? s.status : s;
          if (st === 'disconnected') {
            convo = null;
            voiceActive = false;
            agentSpeaking = false;
            clearTimeout(nudgeTimer);
            setStatus('', 'Presentation stopped');
            updateVoiceLabel();
          }
        },
        onError: function(e) {
          console.warn('conversation error', e);
        }
      });
      voiceActive = true;
      lastAdvanceAt = Date.now();
      slidesShownAt = Date.now();   // v5.0: slide-1 guard starts now
      // v5.2: the greeting itself asks "ready to begin?", so no page
      // kick-off signal is needed — zero waiting between the greeting
      // and the ask.
      begun = true;
      updateVoiceLabel();
      setStatus('speaking', 'Presenting…');
      scheduleNudge();   // safety net in case no mode event arrives
    } catch (e) {
      console.error('could not start conversation', e);
      setStatus('', 'Could not connect — try Start Presentation');
      convo = null;
      voiceActive = false;
      updateVoiceLabel();
    }
  }

  async function stopConversation() {
    clearTimeout(nudgeTimer);
    if (convo) {
      try { await convo.endSession(); } catch (e) {}
    }
    convo = null;
    voiceActive = false;
    agentSpeaking = false;
    setStatus('', 'Presentation stopped');
    updateVoiceLabel();
  }

  // VIMEO WELCOME VIDEO
  const videoIframe = document.getElementById('ailaWelcomeVideo');
  const beginOverlay = document.getElementById('ailaBeginOverlay');
  const skipLink = document.getElementById('ailaSkipLink');

  var vimeoPlayer = null;
  function initVimeo() {
    if (typeof Vimeo === 'undefined') {
      setTimeout(initVimeo, 200);
      return;
    }
    vimeoPlayer = new Vimeo.Player(videoIframe);
    vimeoPlayer.on('ended', function() {
      beginOverlay.style.display = 'block';
    });
  }
  initVimeo();

  function advanceToSlides(e) {
    if (e) e.preventDefault();
    if (vimeoPlayer) { try { vimeoPlayer.pause(); } catch (err) {} }
    document.getElementById('ailaVideoContainer').style.display = 'none';
    document.getElementById('ailaPdfContainer').style.display = 'flex';
    document.getElementById('ailaNav').style.display = 'flex';
    loadPdf();
    startConversation();   // the click is the mic-permission gesture
  }
  skipLink.addEventListener('click', advanceToSlides);
  document.getElementById('ailaBeginButton').addEventListener('click', advanceToSlides);

  // PDF LOADING (preloaded during the welcome video)
  var pdfLoadPromise = null;
  function preloadPdf() {
    if (pdfLoadPromise) return;
    pdfjsLib.GlobalWorkerOptions.workerSrc =
      'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
    pdfLoadPromise = pdfjsLib.getDocument({
      url: COURSE.pdfUrl,
      withCredentials: false
    }).promise;
  }
  function loadPdf() {
    preloadPdf();
    pdfLoadPromise
      .then(function(pdf) {
        pdfDoc = pdf;
        renderSlide(currentSlide);
        updateSlideIndicator();
      })
      .catch(function(error) {
        console.error('PDF load error:', error);
        const canvas = document.getElementById('ailaPdfCanvas');
        const ctx = canvas.getContext('2d');
        ctx.fillStyle = '#fff';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.fillStyle = '#333';
        ctx.font = '16px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('Could not load the presentation PDF.', canvas.width/2, canvas.height/2 - 10);
        ctx.fillText('Check the console for details.', canvas.width/2, canvas.height/2 + 15);
      });
  }

  // MEDIA LINKS -> OVERLAY
  function toVideoEmbed(url) {
    var m = url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/))([A-Za-z0-9_-]{6,})/);
    if (m) return 'https://www.youtube.com/embed/' + m[1] + '?autoplay=1';
    m = url.match(/vimeo\.com\/(?:video\/)?(\d+)(?:\/([a-zA-Z0-9]+))?/);
    if (m) return 'https://player.vimeo.com/video/' + m[1] +
      (m[2] ? '?h=' + m[2] + '&autoplay=1' : '?autoplay=1');
    return null;
  }
  function toAudioUrl(url) {
    return /\.(mp3|m4a|wav|ogg)(\?[^ ]*)?$/i.test(url) ? url : null;
  }
  function toImageUrl(url) {
    return /\.(gif|png|jpe?g|webp)(\?[^ ]*)?$/i.test(url) ? url : null;
  }
  function toDocUrl(url) {
    return /esource-course-developer\.vercel\.app\/[^ ]*\.html/i.test(url) ? url : null;
  }
  function openVideoOverlay(embedUrl) {
    document.getElementById('ailaVideoOverlayFrame').src = embedUrl;
    document.getElementById('ailaVideoOverlay').classList.add('open');
  }
  function openFormOverlay(formUrl) {
    var box = document.querySelector('.aila-video-overlay-box');
    box.classList.add('form');
    document.getElementById('ailaVideoOverlayFrame').src = formUrl;
    document.getElementById('ailaVideoOverlay').classList.add('open');
  }
  function openAudioOverlay(audioUrl) {
    var box = document.querySelector('.aila-video-overlay-box');
    var player = document.getElementById('ailaAudioOverlayPlayer');
    box.classList.add('audio');
    player.src = audioUrl;
    document.getElementById('ailaVideoOverlay').classList.add('open');
    player.play().catch(function() {});
  }
  function openImageOverlay(imageUrl) {
    var box = document.querySelector('.aila-video-overlay-box');
    var pic = document.getElementById('ailaImageOverlayPic');
    box.classList.add('image');
    pic.src = imageUrl;
    document.getElementById('ailaVideoOverlay').classList.add('open');
  }
  function closeVideoOverlay() {
    var box = document.querySelector('.aila-video-overlay-box');
    var player = document.getElementById('ailaAudioOverlayPlayer');
    var pic = document.getElementById('ailaImageOverlayPic');
    document.getElementById('ailaVideoOverlay').classList.remove('open');
    document.getElementById('ailaVideoOverlayFrame').src = '';
    player.pause();
    player.removeAttribute('src');
    pic.removeAttribute('src');
    box.classList.remove('audio');
    box.classList.remove('form');
    box.classList.remove('image');
  }
  document.getElementById('ailaVideoOverlayClose').addEventListener('click', closeVideoOverlay);
  document.getElementById('ailaVideoOverlayPop').addEventListener('click', function() {
    var frameSrc = document.getElementById('ailaVideoOverlayFrame').src;
    var picSrc = document.getElementById('ailaImageOverlayPic').getAttribute('src');
    var src = frameSrc || picSrc;
    if (src) { window.open(src, '_blank', 'noopener'); closeVideoOverlay(); }
  });
  document.getElementById('ailaVideoOverlay').addEventListener('click', function(e) {
    if (e.target === this) closeVideoOverlay();
  });

  // LANGUAGE LAYER — translated slides in place (column-aware)
  var TRANSLATE_URL = 'https://esource-course-developer.vercel.app/api/translate';
  var currentLang = 'en';
  var translationCache = {};
  var translateToken = 0;

  function setLanguage(lang) {
    currentLang = lang;
    document.getElementById('ailaLangSelect').value = lang;
    var intro = document.getElementById('ailaLangSelectIntro');
    if (intro) intro.value = lang;
    renderSlide(currentSlide);
  }
  document.getElementById('ailaLangSelect').addEventListener('change', function(e) {
    setLanguage(e.target.value);
  });

  // LANGUAGE GATE — the choice that drives everything
  document.getElementById('ailaLangGo').addEventListener('click', function() {
    var lang = document.getElementById('ailaLangSelectGate').value;
    setLanguage(lang);
    preloadPdf();   // fetch the slides while the video plays
    document.getElementById('ailaLangGate').classList.add('hidden');
    // Switch subtitles and play on the SAME player, so the
    // "video ended" listener stays alive.
    if (vimeoPlayer) {
      if (lang !== 'en') {
        vimeoPlayer.enableTextTrack(lang).catch(function() {});
      }
      vimeoPlayer.play().catch(function() {});
    }
  });

  function buildLines(textContent, viewport) {
    var rows = [];
    textContent.items.forEach(function(item) {
      if (!item.str || !item.str.trim()) return;
      var tx = pdfjsLib.Util.transform(viewport.transform, item.transform);
      var fontH = Math.hypot(tx[2], tx[3]) || 12;
      var x = tx[4], y = tx[5];
      var w = (item.width || 0) * (viewport.scale || 1);
      var row = null;
      for (var i = 0; i < rows.length; i++) {
        if (Math.abs(rows[i].y - y) < fontH * 0.5) { row = rows[i]; break; }
      }
      if (!row) {
        row = { y: y, fontH: fontH, parts: [] };
        rows.push(row);
      }
      row.fontH = Math.max(row.fontH, fontH);
      row.parts.push({ x: x, w: w, str: item.str });
    });
    var lines = [];
    rows.forEach(function(row) {
      row.parts.sort(function(a, b) { return a.x - b.x; });
      var gapLimit = row.fontH * 1.8;
      var seg = null;
      row.parts.forEach(function(p) {
        if (seg && (p.x - seg.endX) > gapLimit) {
          lines.push(seg);
          seg = null;
        }
        if (!seg) {
          seg = { y: row.y, x: p.x, endX: p.x + p.w, fontH: row.fontH, texts: [] };
        }
        seg.endX = Math.max(seg.endX, p.x + p.w);
        seg.texts.push(p.str);
      });
      if (seg) lines.push(seg);
    });
    lines.forEach(function(line) {
      line.str = line.texts.join(' ').replace(/\s+/g, ' ').trim();
      line.w = line.endX - line.x;
    });
    lines.sort(function(a, b) { return (a.y - b.y) || (a.x - b.x); });
    return lines.filter(function(l) { return l.str; }).slice(0, 100);
  }

  function sampleBg(ctx, line, canvas) {
    try {
      var sx = Math.max(0, Math.round(line.x));
      var sy = Math.max(0, Math.round(line.y - line.fontH * 1.5));
      var data = ctx.getImageData(sx, sy, 4, 4).data;
      var r = 0, g = 0, b = 0, n = data.length / 4;
      for (var i = 0; i < data.length; i += 4) { r += data[i]; g += data[i+1]; b += data[i+2]; }
      return { r: r/n, g: g/n, b: b/n };
    } catch (e) {
      return { r: 255, g: 255, b: 255 };
    }
  }

  function paintTranslation(lines, translated) {
    var canvas = document.getElementById('ailaPdfCanvas');
    var ctx = canvas.getContext('2d');
    ctx.save();
    ctx.textBaseline = 'alphabetic';
    for (var i = 0; i < lines.length; i++) {
      var line = lines[i];
      var text = translated[i];
      if (!text) continue;
      var bg = sampleBg(ctx, line, canvas);
      ctx.fillStyle = 'rgb(' + Math.round(bg.r) + ',' + Math.round(bg.g) + ',' + Math.round(bg.b) + ')';
      ctx.fillRect(line.x - 2, line.y - line.fontH * 1.05, line.w + 4, line.fontH * 1.45);
      var lum = 0.299 * bg.r + 0.587 * bg.g + 0.114 * bg.b;
      ctx.fillStyle = (lum > 140) ? '#111111' : '#ffffff';
      var size = line.fontH;
      ctx.font = size + 'px system-ui, -apple-system, "Segoe UI", Roboto, "Noto Sans", sans-serif';
      while (size > line.fontH * 0.55 && ctx.measureText(text).width > line.w * 1.12) {
        size -= 1;
        ctx.font = size + 'px system-ui, -apple-system, "Segoe UI", Roboto, "Noto Sans", sans-serif';
      }
      ctx.fillText(text, line.x, line.y);
    }
    ctx.restore();
  }

  function applyLanguage(lines, slideNum) {
    if (currentLang === 'en' || !lines.length) return;
    var token = ++translateToken;
    var cache = translationCache[currentLang] = translationCache[currentLang] || {};
    if (cache[slideNum]) {
      if (token === translateToken && slideNum === currentSlide) {
        paintTranslation(lines, cache[slideNum]);
      }
      return;
    }
    var label = document.getElementById('ailaCourseLabel');
    var original = label.textContent;
    label.textContent = original + '  ·  Translating…';
    fetch(TRANSLATE_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        target_lang: currentLang,
        lines: lines.map(function(l) { return l.str; })
      })
    })
      .then(function(r) { if (!r.ok) throw new Error('translate failed'); return r.json(); })
      .then(function(data) {
        label.textContent = original;
        if (!data.lines) return;
        cache[slideNum] = data.lines;
        if (token === translateToken && slideNum === currentSlide) {
          paintTranslation(lines, data.lines);
        }
      })
      .catch(function() {
        label.textContent = original;
      });
  }

  function renderSlide(slideNum) {
    if (!pdfDoc || slideNum < 1 || slideNum > COURSE.totalSlides) return;

    pdfDoc.getPage(slideNum).then(function(page) {
      const canvas = document.getElementById('ailaPdfCanvas');
      const pageDiv = document.getElementById('ailaPdfPage');
      const textLayerDiv = document.getElementById('ailaTextLayer');
      const container = document.getElementById('ailaPdfContainer');
      const containerWidth = container.clientWidth;
      const containerHeight = container.clientHeight;

      const unscaledViewport = page.getViewport({ scale: 1 });
      const scale = Math.min(
        containerWidth / unscaledViewport.width,
        containerHeight / unscaledViewport.height
      );
      const viewport = page.getViewport({ scale: scale });

      pageDiv.style.width = viewport.width + 'px';
      pageDiv.style.height = viewport.height + 'px';

      canvas.width = viewport.width;
      canvas.height = viewport.height;
      canvas.style.width = viewport.width + 'px';
      canvas.style.height = viewport.height + 'px';
      const ctx = canvas.getContext('2d');
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      const renderTask = page.render({ canvasContext: ctx, viewport: viewport });

      textLayerDiv.innerHTML = '';
      textLayerDiv.style.width = viewport.width + 'px';
      textLayerDiv.style.height = viewport.height + 'px';
      textLayerDiv.style.setProperty('--scale-factor', scale);
      page.getTextContent().then(function(textContent) {
        pdfjsLib.renderTextLayer({
          textContentSource: textContent,
          container: textLayerDiv,
          viewport: viewport
        });
        renderTask.promise.then(function() {
          applyLanguage(buildLines(textContent, viewport), slideNum);
        });
      });

      var linkLayerDiv = document.getElementById('ailaLinkLayer');
      linkLayerDiv.innerHTML = '';
      linkLayerDiv.style.width = viewport.width + 'px';
      linkLayerDiv.style.height = viewport.height + 'px';
      page.getAnnotations().then(function(annotations) {
        annotations.forEach(function(annot) {
          if (annot.subtype !== 'Link' || !annot.url) return;
          var rect = pdfjsLib.Util.normalizeRect(
            viewport.convertToViewportRectangle(annot.rect));
          var a = document.createElement('a');
          a.style.left = rect[0] + 'px';
          a.style.top = rect[1] + 'px';
          a.style.width = (rect[2] - rect[0]) + 'px';
          a.style.height = (rect[3] - rect[1]) + 'px';
          a.href = annot.url;
          a.title = annot.url;
          var embed = toVideoEmbed(annot.url);
          var audio = toAudioUrl(annot.url);
          var docPage = toDocUrl(annot.url);
          var image = toImageUrl(annot.url);
          if (embed) {
            a.addEventListener('click', function(e) {
              e.preventDefault();
              openVideoOverlay(embed);
            });
          } else if (docPage) {
            a.addEventListener('click', function(e) {
              e.preventDefault();
              openFormOverlay(docPage);
            });
          } else if (audio) {
            a.addEventListener('click', function(e) {
              e.preventDefault();
              openAudioOverlay(audio);
            });
          } else if (image) {
            a.addEventListener('click', function(e) {
              e.preventDefault();
              openImageOverlay(image);
            });
          } else {
            a.target = '_blank';
            a.rel = 'noopener';
          }
          linkLayerDiv.appendChild(a);
        });
      });

      if (slideNum > highestSlideReached) {
        highestSlideReached = slideNum;
      }
      saveProgress();
    });
  }

  function updateSlideIndicator() {
    document.getElementById('ailaSlideIndicator').textContent =
      'Slide ' + currentSlide + ' of ' + COURSE.totalSlides;
    document.getElementById('ailaPrevBtn').disabled = (currentSlide <= 1);
    document.getElementById('ailaNextBtn').disabled = (currentSlide >= COURSE.totalSlides);
  }

  // RE-FIT SLIDES ON RESIZE OR ROTATION
  var resizeTimer = null;
  window.addEventListener('resize', function() {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(function() {
      if (pdfDoc && document.getElementById('ailaPdfContainer').style.display !== 'none') {
        renderSlide(currentSlide);
      }
    }, 300);
  });

  // FULL-SCREEN MODE
  var displayEl = document.querySelector('.aila-display');
  var fakeFs = false;
  function fsElement() {
    return document.fullscreenElement || document.webkitFullscreenElement || null;
  }
  function refitSoon() {
    setTimeout(function() { if (pdfDoc) renderSlide(currentSlide); }, 150);
  }
  function enterFakeFs() {
    fakeFs = true;
    displayEl.classList.add('fs-fake');
    displayEl.classList.add('fs-active');
    refitSoon();
  }
  function exitFakeFs() {
    fakeFs = false;
    displayEl.classList.remove('fs-fake');
    displayEl.classList.remove('fs-active');
    refitSoon();
  }
  document.getElementById('ailaFsBtn').addEventListener('click', function() {
    if (fakeFs) { exitFakeFs(); return; }
    if (fsElement()) {
      (document.exitFullscreen || document.webkitExitFullscreen).call(document);
      return;
    }
    if (displayEl.requestFullscreen) {
      displayEl.requestFullscreen().catch(function() { enterFakeFs(); });
    } else if (displayEl.webkitRequestFullscreen) {
      displayEl.webkitRequestFullscreen();
    } else {
      enterFakeFs();
    }
  });
  function onFsChange() {
    var active = !!fsElement();
    displayEl.classList.toggle('fs-active', active || fakeFs);
    refitSoon();
  }
  document.addEventListener('fullscreenchange', onFsChange);
  document.addEventListener('webkitfullscreenchange', onFsChange);
  document.getElementById('ailaFsExit').addEventListener('click', function() {
    if (fakeFs) { exitFakeFs(); return; }
    (document.exitFullscreen || document.webkitExitFullscreen).call(document);
  });
  document.getElementById('ailaFsPrev').addEventListener('click', function() {
    document.getElementById('ailaPrevBtn').click();
  });
  document.getElementById('ailaFsNext').addEventListener('click', function() {
    document.getElementById('ailaNextBtn').click();
  });

  // VOICE TOGGLE — real start/stop via the SDK
  function updateVoiceLabel() {
    var btn = document.getElementById('ailaVoiceBtn');
    btn.textContent = voiceActive ? '⏹ Stop Presentation' : '🔊 Start Presentation';
    btn.blur();
  }
  document.getElementById('ailaVoiceBtn').addEventListener('click', function() {
    if (voiceActive) {
      stopConversation();
    } else {
      begun = false;   // fresh session re-opens with slide one's flow
      startConversation();
    }
  });

  // DOCUMENT LINKS — from the agent's messages to the banner
  var seenDocLinks = {};
  var latestDocLink = null;
  var DOC_LINK_RE = /https?:\/\/docs\.(?:esourceaigroup|esourceu)\.com\/[^\s"'<>)\]]+/g;
  function watchForDocLinks(text) {
    var matches = text.match(DOC_LINK_RE) || [];
    for (var i = 0; i < matches.length; i++) {
      var url = matches[i].replace(/[.,;]+$/, '');
      if (!seenDocLinks[url]) {
        seenDocLinks[url] = true;
        latestDocLink = url;
        document.getElementById('ailaDocToast').classList.add('show');
      }
    }
  }
  document.getElementById('ailaDocOpen').addEventListener('click', function() {
    if (latestDocLink) openFormOverlay(latestDocLink);
  });
  document.getElementById('ailaDocDismiss').addEventListener('click', function() {
    document.getElementById('ailaDocToast').classList.remove('show');
  });

  // NAVIGATION CONTROLS (manual moves also tell the agent)
  document.getElementById('ailaPrevBtn').addEventListener('click', function() {
    if (currentSlide > 1) {
      currentSlide--;
      lastAdvanceAt = Date.now();
      renderSlide(currentSlide);
      updateSlideIndicator();
      tellAgentSlide();
    }
  });
  document.getElementById('ailaNextBtn').addEventListener('click', function() {
    if (currentSlide < COURSE.totalSlides) {
      currentSlide++;
      lastAdvanceAt = Date.now();
      renderSlide(currentSlide);
      updateSlideIndicator();
      tellAgentSlide();
    }
  });
  document.getElementById('ailaSectionJump').addEventListener('change', function(e) {
    const target = parseInt(e.target.value);
    if (target >= 1 && target <= COURSE.totalSlides) {
      currentSlide = target;
      lastAdvanceAt = Date.now();
      renderSlide(currentSlide);
      updateSlideIndicator();
      tellAgentSlide();
    }
    e.target.value = '';
  });
  document.getElementById('ailaSyncBtn').addEventListener('click', function() {
    tellAgentSlide();
    alert('The presenter has been synced to slide ' + currentSlide + '.');
  });

  // RESUME PROGRESS (browser localStorage)
  function saveProgress() {
    try {
      localStorage.setItem('esource_presenter_progress_' + COURSE.id, JSON.stringify({
        lastSlide: currentSlide,
        highestSlideReached: highestSlideReached,
        timestamp: Date.now()
      }));
    } catch (e) {}
  }

  // HIDE ACTIVATION CUE AFTER 60 SECONDS
  setTimeout(function() {
    const cue = document.getElementById('ailaActivationCue');
    if (cue) cue.style.display = 'none';
  }, 60000);

  } // end bootWithLibrary
</script>
